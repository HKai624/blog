# =====================================================================
# WorkMate 智能职场个人行政助理 — 环境变量示例模板
#
# 使用方法：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 在 .env 中填入你自己的真实密钥（.env 已被 .gitignore 忽略，不会提交到 Git）
#   3. 本文件只保留变量名和说明，绝不填写真实值，可安全提交到仓库
# =====================================================================

# ── LLM 主模型 (DeepSeek) ─────────────────────────────────────
# 在 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=你的DeepSeek密钥

# ── 智谱 GLM 视觉 + Embedding ────────────────────────────────
# 在 https://open.bigmodel.cn 申请，用于图片识别与向量嵌入
ZHIPU_API_KEY=你的智谱密钥
# 视觉模型（可选，默认 glm-4v-plus）
# VISION_MODEL=glm-4v-plus

# ── QQ 邮箱 SMTP（每日早报发信用） ────────────────────────────
# QQ 邮箱需开启 SMTP 服务，并使用授权码（不是登录密码）
QQ_EMAIL_ADDRESS=你的QQ邮箱地址@qq.com
QQ_EMAIL_PASSWORD=你的QQ邮箱SMTP授权码

# ── 飞书机器人 ────────────────────────────────────────────────
# 在 https://open.feishu.cn 创建自建应用获取
FEISHU_APP_ID=你的飞书AppID
FEISHU_APP_SECRET=你的飞书AppSecret
FEISHU_VERIFICATION_TOKEN=你的飞书VerificationToken
FEISHU_ENCRYPT_KEY=你的飞书EncryptKey

# ── MinerU 文档解析 ───────────────────────────────────────────
# 在 https://mineru.net 申请，用于 PDF/Word/Excel 解析
MINERU_API_TOKEN=你的MinerU访问令牌
# MINERU_BASE_URL=https://mineru.net/api/v4

# ── 登录账号（演示用简单认证） ────────────────────────────────
# admin 账号密码
ADMIN_PASSWORD=管理员密码
# hk 账号（飞书用户）密码及飞书 user_id
HK_PASSWORD=飞书用户密码
HK_FEISHU_USER_ID=飞书用户OpenID

# ── 可选：RAG / 服务运行参数 ──────────────────────────────────
# 以下变量代码内已有默认值，按需覆盖即可
# SERVER_PORT=8000
# DEBUG_MODE=true
# MAX_CONTEXT_TOKENS=3000
# MAX_OUTPUT_TOKENS=1024
# VECTOR_STORE_BACKEND=chroma
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
